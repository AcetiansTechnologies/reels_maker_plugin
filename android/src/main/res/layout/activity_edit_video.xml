<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A"

    android:orientation="vertical">

    <!-- Top Bar with Back and Save buttons -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:padding="8dp">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/backBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/btn_bg_sq"
            android:contentDescription="Back"
            android:padding="16dp"
            android:src="@drawable/ic_back"
            android:tint="@android:color/white" />

        <!-- Save Button -->
        <ImageButton
            android:id="@+id/saveBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/btn_bg_sq"
            android:contentDescription="Save"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_go"
            android:tint="@android:color/white" />
    </RelativeLayout>

    <!-- Video Player Container -->
    <RelativeLayout
        android:id="@+id/videoPlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent">

        <!-- PlayerView for ExoPlayer -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            app:surface_type="texture_view"
            app:use_controller="false" />

        <!-- Play Button (centered) -->
        <ImageButton
            android:id="@+id/playBtn"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_centerInParent="true"
            android:background="@drawable/btn_bg"
            android:contentDescription="Play"
            android:padding="12dp"
            android:src="@drawable/ic_play"
            android:tint="@android:color/white" />
    </RelativeLayout>


    <!-- Playback Controls (Timeline) -->
    <LinearLayout
        android:id="@+id/playbackControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingHorizontal="16dp">

        <!-- Time Display -->
        <TextView
            android:id="@+id/timeDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:layout_marginStart="8dp"
            android:text="0:00 / 0:00"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:textSize="12sp" />


        <!-- Mute Button -->
        <ImageButton
            android:id="@+id/muteBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mute Toggle"
            android:padding="4dp"
            android:src="@drawable/ic_music"
            android:tint="@android:color/white" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="16dp"
        android:paddingHorizontal="12dp">
        <!-- Seek Bar -->
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:progressTint="@android:color/white"
            android:thumbTint="@android:color/white" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/trimControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- TIME ROW -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/startTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/endTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="0:00"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- SELECTION FRAME -->
        <FrameLayout
            android:id="@+id/trimSelectionContainer"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/bg_trim_selection"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/thumbnailRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never" /><!-- PLAYHEAD LINE -->
            <View
                android:id="@+id/playheadView"
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="#FFFFFFFF" />

            <View
                android:id="@+id/selectedRangeView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@drawable/bg_selected_range" />
            <!-- LEFT HANDLE -->
            <View
                android:id="@+id/leftHandle"
                android:layout_width="14dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@drawable/bg_trim_handle_left" />

            <!-- RIGHT HANDLE -->
            <View
                android:id="@+id/rightHandle"
                android:layout_width="14dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@drawable/bg_trim_handle_right" />
        </FrameLayout>

    </LinearLayout>

    <!-- VOICE OVER CONTROLS -->
    <LinearLayout
        android:id="@+id/voiceOverControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="12dp"
        android:background="#2A2A2A"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <CheckBox
            android:id="@+id/voiceMixBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:buttonTint="@android:color/white"
            android:checked="true"
            android:text="Keep Original Video Sound"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/voiceStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Tap mic to record"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/voiceRecordBtn"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/btn_bg_sq"
                android:contentDescription="Record Voice"
                android:padding="16dp"
                android:src="@drawable/ic_mic"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/voiceDeleteBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/btn_bg_sq"
                android:contentDescription="Delete Voice"
                android:padding="12dp"
                android:src="@drawable/ic_refresh"
                android:tint="#FF5555"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Edit Options Bar -->
    <LinearLayout
        android:id="@+id/editOptionsBar"
        android:layout_width="match_parent"

        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <!-- Edit Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/trimBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/btn_bg_sq"
                android:contentDescription="Trim"
                android:padding="16dp"
                android:src="@drawable/ic_scissors"
                android:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Edit"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Audio Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/audioBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/btn_bg_sq"
                android:contentDescription="Audio"
                android:padding="16dp"
                android:src="@drawable/ic_music"
                android:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Audio"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Text Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/textBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/btn_bg_sq"
                android:contentDescription="Text"
                android:padding="16dp"
                android:src="@drawable/ic_text"
                android:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Text"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Voiceover Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/voiceoverBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/btn_bg_sq"
                android:contentDescription="Voiceover"
                android:padding="16dp"
                android:src="@drawable/ic_mic"
                android:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Voice"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Filters Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/filtersBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/btn_bg_sq"
                android:contentDescription="Filters"
                android:padding="16dp"
                android:src="@drawable/ic_mackeup"
                android:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Filters"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>